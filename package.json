{
  "name": "bingo-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Gerenciador das cartelas do Show de Prêmios APAE Santa Rita do Sapucaí 2026",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/e2e",
    "test:e2e": "playwright test",
    "test:e2e:fluxos": "playwright test tests/e2e/fluxos.spec.ts",
    "test:e2e:simulacao": "playwright test tests/e2e/simulacao.spec.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
